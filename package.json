{
  "name": "shift-overlap-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Prisma API that checks nurse shift overlaps against facility thresholds",
  "main": "server.js",
  "engines": {
    "node": ">=22.9.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prisma": "^6.19.0",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
