# Dependencies
node_modules/
jspm_packages/
bower_components/
project_venv/

# Environment files (keep the example)
.env
.env.*
!.env.example

# Build output
client/build/
client/dist/
dist/
build/Release
out/

# Local databases (the project uses PostgreSQL; guard against SQLite dev files)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db*

# Unreferenced Font Awesome files (same folder shape as the decoy-font malware
# seen in sibling repos); kept on disk, never committed
public/fonts/

# Logs and runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.pid.lock

# Coverage and caches
coverage/
.nyc_output/
*.lcov
.npm/
.eslintcache
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo
tmp/
.temp/

# CI config is intentionally not part of this repo
.github/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
